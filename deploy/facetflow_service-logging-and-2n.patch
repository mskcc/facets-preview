 FACETS_IRIS_WRAPPER = os.environ.get("FACETS_IRIS_WRAPPER")
 FACETS_IRIS_RLIBS = os.environ.get("FACETS_IRIS_RLIBS")
 FACETS_IRIS_REFIT_QUEUE = os.environ.get("FACETS_IRIS_REFIT_QUEUE")
+
+# 2n refits: the pinned facets_2n_cadence .sif that a queued 2n job runs under,
+# and the directory holding the facets2n reference normal pools. The Shiny app
+# reads these as FP_IRIS_2N_SIF / FP_IRIS_2N_REF_LIB_DIR; with them unset it
+# refuses a 2n refit with an explanatory dialog rather than queueing a bad job.
+FACETS_IRIS_2N_SIF = os.environ.get("FACETS_IRIS_2N_SIF", "")
+FACETS_IRIS_2N_REF_LIB_DIR = os.environ.get("FACETS_IRIS_2N_REF_LIB_DIR", "")
+
+# Host directory bind-mounted into every session container as /fp_logs. When set,
+# the container writes a per-session log file there instead of to its stdout,
+# which is what stops the (uncapped) Docker json-file logs from filling
+# /var/lib/docker and wedging the daemon.
+FACETS_LOG_DIR = os.environ.get("FACETS_LOG_DIR", "")
+
+# Per-container log rotation. A container still emits a little stdout even with
+# FP_LOG_DIR set, and one started without it would otherwise grow without bound:
+# the daemon default json-file driver has no max-size.
+FACETS_LOG_MAX_SIZE = os.environ.get("FACETS_LOG_MAX_SIZE", "10m")
+FACETS_LOG_MAX_FILE = os.environ.get("FACETS_LOG_MAX_FILE", "3")
